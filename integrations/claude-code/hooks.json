{
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "simgit",
            "args": ["hook", "claude-code", "--requires", "0.5.0"],
            "timeout": 1800
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "simgit",
            "args": ["hook", "claude-code", "--requires", "0.5.0", "--discard-dirty"]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "simgit hook claude-code --requires 0.5.0 || exit 0"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "simgit hook claude-code --requires 0.5.0 >/dev/null 2>&1 || echo '{\"systemMessage\": \"The simgit plugin needs simgit 0.5.0 or newer: brew install abendrothj/tap/simgit (or brew upgrade simgit)\"}'"
          }
        ]
      }
    ]
  }
}
